{
  "name": "antigravity-cli",
  "displayName": "Antigravity CLI",
  "description": "Open Antigravity CLI (agy) in VS Code terminal — your AI-powered coding assistant",
  "version": "0.0.3",
  "publisher": "nuwanthapasindu",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nuwanthapasindu/antigravity-cli-vs-code-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "antigravity",
    "agy",
    "ai",
    "terminal",
    "cli"
  ],
  "activationEvents": [
    "onView:antigravity.welcomeView",
    "onCommand:antigravity.openAgent",
    "onCommand:antigravity.openTerminal",
    "onCommand:antigravity.restartTerminal",
    "onCommand:antigravity.stopTerminal",
    "onCommand:antigravity.askAgent",
    "onCommand:antigravity.explainCode",
    "onCommand:antigravity.refactorCode"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.openTerminal",
        "title": "Antigravity CLI: Open Terminal",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        }
      },
      {
        "command": "antigravity.restartTerminal",
        "title": "Antigravity CLI: Restart Terminal",
        "icon": "$(debug-restart)"
      },
      {
        "command": "antigravity.stopTerminal",
        "title": "Antigravity CLI: Stop Terminal",
        "icon": "$(debug-stop)"
      },
      {
        "command": "antigravity.openAgent",
        "title": "Antigravity: Open Coding Agent"
      },
      {
        "command": "antigravity.askAgent",
        "title": "Antigravity: Ask About Selected Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "antigravity.explainCode",
        "title": "Antigravity: Explain Selected Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "antigravity.refactorCode",
        "title": "Antigravity: Refactor Selected Code",
        "icon": "$(wand)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity.openTerminal",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "antigravity.openAgent",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sidebar",
          "title": "Antigravity CLI",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "antigravity-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.welcomeView",
          "name": "Antigravity CLI"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "title": "Antigravity CLI",
          "id": "antigravity.terminalProfile",
          "icon": "hubot"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity CLI",
      "properties": {
        "antigravity.executable": {
          "type": "string",
          "default": "agy",
          "description": "Path to the agy executable (default: agy, assuming it is in your PATH)"
        },
        "antigravity.defaultArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Default arguments to pass to agy on launch"
        },
        "antigravity.agent.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scroll to bottom during streaming agent tokens"
        },
        "antigravity.agent.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model for agent queries (leave empty for auto-detection)"
        },
        "antigravity.agent.defaultEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "high",
          "description": "Default reasoning effort level for agent queries"
        },
        "antigravity.mode": {
          "type": "string",
          "enum": [
            "accept-edits",
            "default",
            "plan",
            "auto-approve"
          ],
          "enumDescriptions": [
            "Accept Edits: Automatically approve file edits, prompt for shell commands (Default)",
            "Review All: Review and prompt for all tool executions and file changes",
            "Plan Only: Read-only planning and research mode, no workspace modifications",
            "Auto-Approve: Bypass permission prompts (runs with --dangerously-skip-permissions)"
          ],
          "default": "accept-edits",
          "description": "Execution mode and permission gating level for Antigravity Agent"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "antigravity.openTerminal",
          "group": "navigation",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "antigravity.askAgent",
          "group": "antigravity@0",
          "when": "editorHasSelection"
        },
        {
          "command": "antigravity.explainCode",
          "group": "antigravity@1",
          "when": "editorHasSelection"
        },
        {
          "command": "antigravity.refactorCode",
          "group": "antigravity@2",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  }
}
